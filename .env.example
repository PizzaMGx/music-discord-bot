DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional: set this while developing so slash commands update immediately
# in one server. This is the numeric Discord server ID.
DISCORD_GUILD_ID=

# Optional: only required for Spotify playlist links. Spotify tracks are
# searched for and downloaded from YouTube because Spotify audio is not fetched.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# The Docker defaults are normally correct. Change these only for a non-Docker run.
DOWNLOAD_DIR=/downloads
PLAYLISTS_DIR=/playlists
